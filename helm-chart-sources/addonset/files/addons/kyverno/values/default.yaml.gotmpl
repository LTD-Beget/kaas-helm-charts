kyverno:
  features:
    forceFailurePolicyIgnore:
      enabled: true

  admissionController:
    container:
      resources:
        requests:
          cpu: 50m
          memory: 64Mi

  backgroundController:
    resources:
      requests:
        cpu: 50m
        memory: 64Mi

  cleanupController:
    resources:
      requests:
        cpu: 50m
        memory: 64Mi

  reportsController:
    resources:
      requests:
        cpu: 50m
        memory: 64Mi
