kyverno:
  config:
    webhooks:
      namespaceSelector:
        matchExpressions:
          - key: kubernetes.io/metadata.name
            operator: NotIn
            values:
              - kube-system
              - kube-public
              - kube-node-lease
              - {{ .Values.companyPrefix }}-cilium
              - {{ .Values.companyPrefix }}-coredns
              - {{ .Values.companyPrefix }}-konnectivity-agent
