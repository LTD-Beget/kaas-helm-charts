victoria-metrics-k8s-stack:
  alertmanager:
    ingress:
      enabled: false
    monzoTemplate:
      enabled: false
    spec:
      replicaCount: 2
      routePrefix: /alertmanager
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                topologyKey: kubernetes.io/hostname
                labelSelector:
                  matchExpressions:
                    - key: app.kubernetes.io/name
                      operator: In
                      values:
                        - vmalertmanager
      templates:
        - key: telegram_alerts.tmpl
          name: vm-alertmanager-alertmanager-alert-templates
      serviceSpec:
        metadata:
          name: vmalertmanager
          labels:
            monitoring.in-cloud.io/service: vm-alertmanager
        spec:
          ports:
            - name: http
              port: 9093
              protocol: TCP
              targetPort: 9093
      selectAllByDefault: false
      priorityClassName: system-cluster-critical
      configSelector: {}
      configNamespaceSelector: {}
      configSecret: vmalertmanager-config
      resources:
        requests:
          cpu: '100m'
          memory: 128Mi
        limits:
          cpu: '500m'
          memory: 512Mi
      extraEnvs:
        - name: GOMAXPROCS
          value: '1'
      extraArgs:
        cluster.reconnect-timeout: "15m"
      tolerations:
        - key: "node-role.kubernetes.io/control-plane"
          operator: "Exists"
          effect: "NoSchedule"
        - key: "node-role.kubernetes.io/master"
          operator: "Exists"
          effect: "NoSchedule"

monitoring:
  enabled: true
  vmalertmanager:
    serviceScrapeConfig:
      metricRelabelConfigs:
        - sourceLabels: [__name__]
          action: keep
          regex: "\
            alertmanager_alerts|\
            alertmanager_alerts_received_total|\
            alertmanager_build_info|\
            alertmanager_cluster_failed_peers|\
            alertmanager_cluster_health_score|\
            alertmanager_cluster_members|\
            alertmanager_cluster_messages_pruned_total|\
            alertmanager_cluster_messages_queued|\
            alertmanager_cluster_messages_received_size_total|\
            alertmanager_cluster_messages_received_total|\
            alertmanager_cluster_messages_sent_size_total|\
            alertmanager_cluster_messages_sent_total|\
            alertmanager_cluster_peers_joined_total|\
            alertmanager_cluster_peers_left_total|\
            alertmanager_cluster_reconnections_failed_total|\
            alertmanager_cluster_reconnections_total|\
            alertmanager_config_last_reload_success_timestamp_seconds|\
            alertmanager_config_last_reload_successful|\
            alertmanager_nflog_gc_duration_seconds_count|\
            alertmanager_nflog_gc_duration_seconds_sum|\
            alertmanager_nflog_gossip_messages_propagated_total|\
            alertmanager_nflog_queries_total|\
            alertmanager_nflog_query_duration_seconds_bucket|\
            alertmanager_nflog_query_errors_total|\
            alertmanager_nflog_snapshot_duration_seconds_sum|\
            alertmanager_nflog_snapshot_size_bytes|\
            alertmanager_notification_latency_seconds_bucket|\
            alertmanager_notifications_failed_total|\
            alertmanager_notifications_total|\
            alertmanager_oversize_gossip_message_duration_seconds_bucket|\
            alertmanager_oversized_gossip_message_dropped_total|\
            alertmanager_oversized_gossip_message_failure_total|\
            alertmanager_oversized_gossip_message_sent_total|\
            alertmanager_silences|\
            alertmanager_silences_gc_duration_seconds_count|\
            alertmanager_silences_gc_duration_seconds_sum|\
            alertmanager_silences_gossip_messages_propagated_total|\
            alertmanager_silences_queries_total|\
            alertmanager_silences_query_duration_seconds_bucket|\
            alertmanager_silences_query_errors_total|\
            alertmanager_silences_snapshot_duration_seconds_count|\
            alertmanager_silences_snapshot_duration_seconds_sum|\
            alertmanager_silences_snapshot_size_bytes|\
            go_gc_duration_seconds_count|\
            go_gc_duration_seconds_sum|\
            go_goroutines|\
            go_memstats_alloc_bytes_total|\
            go_memstats_gc_sys_bytes|\
            go_memstats_heap_idle_bytes|\
            go_memstats_heap_inuse_bytes|\
            go_memstats_heap_released_bytes|\
            go_memstats_mcache_sys_bytes|\
            go_memstats_mspan_sys_bytes|\
            go_memstats_other_sys_bytes|\
            go_memstats_stack_inuse_bytes|\
            go_memstats_sys_bytes|\
            process_cpu_seconds_total|\
            process_max_fds|\
            process_open_fds|\
            process_resident_memory_bytes|\
            process_start_time_seconds|\
            process_virtual_memory_bytes|\
            scrape_series_added|\
            up\
            "

alertmanagerConfig:
  enabled: true
  config:
    global:
      resolve_timeout: 5m

    route:
      receiver: blackhole
      group_by: ["cluster_full_name", "alertname", "severity"]
      group_wait: 10s
      group_interval: 30s
      repeat_interval: 3h

      routes:
        blackhole:
          matchers:
            - alertname="Watchdog"
          receiver: blackhole
        telegram:
          matchers:
            - severity="critical"
          receiver: telegram-critical
          continue: true

    receivers:
      blackhole: {}
      telegram-critical:
        type: telegram_configs
        configs:
          criticalAlertGroup:
            bot_token: "{{ .Values.telegramToken }}"
            chat_id: {{ .Values.telegramChatId }}
            parse_mode: 'HTML'
            send_resolved: true
            message: '{{`{{ template "tg.message" . }}`}}'

    inhibit_rules:
      # Более критичный алерт InCloudCapiClusterNotAlive глушит каскадные алерты
      - source_matchers:
          - alertname="InCloudCapiClusterNotAlive"
        target_matchers:
          - alertname=~"ArgoCdClusterConnectionError|InCloudCapiClusterNotReadyTooLong|VMAgentJobAbsent|VMAlertJobAbsent|VMAlertmanagerJobAbsent|VMAgentScrapePoolHasDownTargets|VMagentLogsErrorsHigh"
        equal:
          - cluster_full_name

      # Более критичный алерт глушит аналогичный предупредительный
      - source_matchers:
          - alertname="ArgoCdClusterConnectionError"
        target_matchers:
          - alertname=~"ArgoCdAppUnhealthy|ArgoCdAppOutOfSync|ArgoCdAppSyncFailed"
        equal:
          - cluster_full_name

      # Более критичный алерт глушит аналогичный предупредительный
      - source_matchers:
          - alertname="CoreDNSErrorsHighCritical"
        target_matchers:
          - alertname="CoreDNSErrorsHigh"
        equal:
          - cluster_full_name

      # Более критичный алерт глушит аналогичный предупредительный
      - source_matchers:
          - alertname="ExtremelyHighIndividualControlPlaneCPU"
        target_matchers:
          - alertname=~"HighIndividualControlPlaneCPU|HighOverallControlPlaneCPU"
        equal:
          - cluster_full_name

      # Более критичный алерт глушит аналогичный предупредительный
      - source_matchers:
          - alertname="InCloudCapiClusterNotReadyTooLong"
        target_matchers:
          - alertname="InCloudCapiClusterNotReady"
        equal:
          - cluster_full_name

      # Более критичный алерт глушит аналогичный предупредительный
      - source_matchers:
          - alertname="VMAgentScrapePoolHasDownTargets"
        target_matchers:
          - alertname="VMAgentScrapePoolHasNoTargets"
        equal:
          - cluster_full_name

      # Пока работает info алерт InCloudCapiClusterMuted (С момента 
      # создания клатсера прошло менее 15 минут или клатсер в процессе удаления)
      # Глушатся все алерты кроме InCloudCapiClusterDeletionRequestedTooLong, на 
      # случай, если процесс удаления длится более 15 минут
      - source_matchers:
          - alertname="InCloudCapiClusterMuted"
        target_matchers:
          - alertname!="InCloudCapiClusterDeletionRequestedTooLong"
        equal:
          - cluster_full_name

      # Алерт InCloudCapiInfraClusterSuspended/InCloudCapiClientClusterSuspended 
      # нам говорит о том, что кластер заблокирован и не обслуживается. 
      # На время блокировки все алерты приостановлены
      - source_matchers:
          - alertname=~"InCloudCapiInfraClusterSuspended|InCloudCapiClientClusterSuspended"
        target_matchers:
          - alertname!=""
        equal:
          - cluster_full_name

      # Алерт InCloudCapiClusterIsPaused нам говорит о том, что кластер стоит на паузе
      #  и его состояние не изменяется средствами операторов. 
      # На время паузы алерты готовности кластера приостановлены,
      # в случае проблем с кластером, есть алерты alive
      - source_matchers:
          - alertname="InCloudCapiClusterIsPaused"
        target_matchers:
          - alertname=~"InCloudCapiClusterNotReady|InCloudCapiClusterNotReadyTooLong"
        equal:
          - cluster_full_name
