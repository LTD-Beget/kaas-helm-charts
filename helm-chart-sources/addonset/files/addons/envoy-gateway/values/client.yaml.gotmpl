gateway-helm:
  deployment:
    pod:
      labels:
        toleration.{{ .Values.companyDomain }}/ignore: "true"
      tolerations:
        - operator: "Exists"
  certgen:
    job:
      pod:
        labels:
          toleration.{{ .Values.companyDomain }}/ignore: "true"
      tolerations:
        - operator: "Exists"
  # Upstream ships hpa disabled with replicas: 1 — scale the controller on CPU.
  hpa:
    enabled: true
    minReplicas: 1
    maxReplicas: 2
    metrics:
      - type: Resource
        resource:
          name: cpu
          target:
            type: Utilization
            averageUtilization: 80
envoyProxy:
  pod:
    labels:
      toleration.{{ .Values.companyDomain }}/ignore: "true"
    tolerations:
      - operator: "Exists"
  # Wrapper default is disabled — scale the managed Envoy fleet on CPU.
  autoscaling:
    enabled: true
    minReplicas: 1
    maxReplicas: 5
    targetCPUUtilizationPercentage: 80
