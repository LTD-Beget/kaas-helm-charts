istiod:
  pilot:
    autoscaleMin: 2
  podAnnotations:
    cluster-autoscaler.kubernetes.io/safe-to-evict: "false"
  affinity:
    podAntiAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          podAffinityTerm:
            labelSelector:
              matchLabels:
                app.kubernetes.io/name: istiod
                app.kubernetes.io/instance: istiod
            topologyKey: kubernetes.io/hostname