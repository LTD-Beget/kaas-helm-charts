resources:
  customerCsrcToExternal6443:
    apiVersion: cilium.io/v2
    kind: CiliumClusterwideNetworkPolicy
    metadata:
      name: allow-customer-csrc-to-external-6443
    spec:
      endpointSelector:
        matchLabels:
          k8s:app.kubernetes.io/name: csrc-infra
      egress:
      - toEntities:
        - kube-apiserver
        - remote-node
        toPorts:
        - ports:
          - port: "6443"
            protocol: TCP
      - toCIDR:
        - 0.0.0.0/0
        toPorts:
        - ports:
          - port: "6443"
            protocol: TCP
  customerCcmToExternal6443:
    apiVersion: cilium.io/v2
    kind: CiliumClusterwideNetworkPolicy
    metadata:
      name: allow-customer-ccm-to-external-6443
    spec:
      endpointSelector:
        matchLabels:
          k8s:app.kubernetes.io/name: ccm-infra
      egress:
      - toEntities:
        - kube-apiserver
        - remote-node
        toPorts:
        - ports:
          - port: "6443"
            protocol: TCP
      - toCIDR:
        - 0.0.0.0/0
        toPorts:
        - ports:
          - port: "6443"
            protocol: TCP
  customerCsrcToCoredns53:
    apiVersion: cilium.io/v2
    kind: CiliumClusterwideNetworkPolicy
    metadata:
      name: allow-customer-csrc-to-coredns-53
    spec:
      endpointSelector:
        matchLabels:
          k8s:app.kubernetes.io/name: csrc-infra
      egress:
      - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: {{ .Values.companyPrefix }}-coredns
            k8s:io.cilium.k8s.policy.serviceaccount: coredns
        toPorts:
        - ports:
          - port: "53"
            protocol: UDP
          - port: "53"
            protocol: TCP
  customerCcmToCoredns53:
    apiVersion: cilium.io/v2
    kind: CiliumClusterwideNetworkPolicy
    metadata:
      name: allow-customer-ccm-to-coredns-53
